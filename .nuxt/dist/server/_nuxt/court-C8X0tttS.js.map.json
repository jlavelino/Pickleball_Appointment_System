{"file":"court-C8X0tttS.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;AA0CA,UAAM,QAAQ;AAUd,UAAM,SAAS,SAAS,MAAM,MAAM,WAAW,MAAM;AAErD,UAAM,YAAY,SAAS,MAAM;AAC/B,UAAI,MAAM,WAAW,OAAQ,QAAO;AACpC,UAAI,MAAM,WAAW,MAAO,QAAO;AACnC,aAAO;AAAA,IACT,CAAC;AAED,UAAM,aAAa,SAAS,MAAM;AAChC,UAAI,MAAM,WAAW,OAAQ,QAAO;AACpC,UAAI,MAAM,WAAW,MAAO,QAAO;AACnC,aAAO;AAAA,IACT,CAAC;;;QA9DG,QAAM,yEAAuE;AAAA,UAC5D,QAAA,aAAU,6BAAA;AAAA,UAA2C,OAAA,QAAM,eAAA;AAAA,QAAA;4HAMnBA,eAAA,QAAA,MAAM,IAAI,uCAGvD,WAAA,OAAU,yDAAA,CAAA,qBAEf,UAAA,KAAS,oEAIVA,eAAA,QAAA,MAAM,KAAK,cAAgBA,eAAA,QAAA,MAAM,IAAI,qDAI9B,OAAA,KAAM,IAAA,cAAA;QAGE,QAAA,8CAAoE,OAAA;kHAQpFA,eAAA,QAAA,0BAA0B,OAAA,QAAM,SAAA,cAAA;;;;;;;;;;;;;;ACAzC,YAAQ,EAAE,OAAO,uBAAuB;AAExC,UAAM,QAAQ,gBAAA;AACd,QAAI,MAAM,cAAc,MAAM;AAC5B,iBAAW,GAAG;AAAA,IAChB;AAEA,aAAS,YAAY,IAAY;AAC/B,YAAM,SAAS,EAAE;AAAA,IACnB;AAEA,aAAS,SAAS;AAChB,UAAI,MAAM,YAAY,MAAM;AAC1B,mBAAW,eAAe;AAAA,MAC5B;AAAA,IACF;;mBA/COC,eAAAC,WAAA,EAAA,OAAM,8BAA0B,MAAA,CAAA,8LAM5BF,eAAAG,MAAA,KAAA,EAAM,cAAc,OAASH,eAAAG,MAAA,KAAA,EAAM,SAAS;AAInCC,oBAAAD,MAAA,MAAA,IAAL,MAAC;;UACP,KAAK,EAAE;AAAA,UACP,OAAO;AAAA,UACP,QAAQA,MAAA,KAAA,EAAM,gBAAgB,EAAE,EAAE;AAAA,UAClC,eAAaA,MAAA,KAAA,EAAM,YAAY,EAAE;AAAA,UACjC,UAAQ;AAAA,QAAA;;;;QAKX,OAAM;AAAA,QACL,UAAUA,MAAA,KAAA,EAAM,YAAO;AAAA,QACvB,SAAO;AAAA,MAAA;;;;;;;;;;;","names":["_ssrInterpolate","_ssrRenderAttrs","_mergeProps","_unref","_ssrRenderList"],"sources":["../../../../components/booking/CourtCard.vue","../../../../pages/book/court.vue"],"sourcesContent":["<template>\r\n  <div\r\n    class=\"border border-line bg-white rounded-card p-[18px] mb-4 transition-all\"\r\n    :class=\"[\r\n      isSelected ? 'border-lime bg-lime-soft' : '',\r\n      isFull ? 'opacity-55' : ''\r\n    ]\"\r\n  >\r\n    <div class=\"flex justify-between items-start mb-1\">\r\n      <div class=\"font-display font-semibold text-[19px]\">{{ court.name }}</div>\r\n      <span\r\n        class=\"text-[12.5px] font-semibold px-[11px] py-1 rounded-full\"\r\n        :class=\"badgeClass\"\r\n      >\r\n        {{ badgeText }}\r\n      </span>\r\n    </div>\r\n    <div class=\"text-ink-soft text-[14px] mb-[14px]\">\r\n      ₱{{ court.price }} / hour · {{ court.type }}\r\n    </div>\r\n    <button\r\n      type=\"button\"\r\n      :disabled=\"isFull\"\r\n      @click=\"$emit('select', court.id)\"\r\n      class=\"w-full p-[13px] rounded-[11px] font-semibold text-[15px] cursor-pointer transition-colors border\"\r\n      :class=\"[\r\n        isSelected\r\n          ? 'bg-ink text-white border-ink'\r\n          : isFull\r\n            ? 'cursor-not-allowed border-line text-gray bg-white'\r\n            : 'border-ink bg-white text-ink hover:bg-ink hover:text-white'\r\n      ]\"\r\n    >\r\n      {{ isSelected ? 'Selected' : isFull ? 'Full' : 'Select court' }}\r\n    </button>\r\n  </div>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nimport { computed } from 'vue'\r\nimport type { Court } from '~/stores/booking'\r\n\r\nconst props = defineProps<{\r\n  court: Court\r\n  status: 'open' | 'low' | 'full'\r\n  isSelected: boolean\r\n}>()\r\n\r\ndefineEmits<{\r\n  select: [id: number]\r\n}>()\r\n\r\nconst isFull = computed(() => props.status === 'full')\r\n\r\nconst badgeText = computed(() => {\r\n  if (props.status === 'open') return 'Open'\r\n  if (props.status === 'low') return '1 left'\r\n  return 'Full'\r\n})\r\n\r\nconst badgeClass = computed(() => {\r\n  if (props.status === 'open') return 'bg-lime-soft text-lime-text'\r\n  if (props.status === 'low') return 'bg-danger-bg text-danger-text'\r\n  return 'bg-[#EFEAE0] text-gray'\r\n})\r\n</script>\r\n","<template>\r\n  <div class=\"flex flex-col min-h-full\">\r\n    <div class=\"flex-1\">\r\n      <h1 class=\"font-display font-semibold text-[28px] m-0 leading-[1.15] mb-0.5 mt-1.5\">\r\n        Pick a court\r\n      </h1>\r\n      <p class=\"text-ink-soft text-[14.5px] m-0 mb-5 leading-[1.4]\">\r\n        {{ store.slotRangeLabel }} · {{ store.dateLabel }}\r\n      </p>\r\n\r\n      <CourtCard\r\n        v-for=\"c in COURTS\"\r\n        :key=\"c.id\"\r\n        :court=\"c\"\r\n        :status=\"store.courtsStatusMap[c.id]\"\r\n        :is-selected=\"store.courtId === c.id\"\r\n        @select=\"selectCourt\"\r\n      />\r\n    </div>\r\n\r\n    <BottomCTA\r\n      label=\"Continue\"\r\n      :disabled=\"store.courtId === null\"\r\n      @click=\"goNext\"\r\n    />\r\n  </div>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nimport { useBookingStore, COURTS } from '~/stores/booking'\r\nimport CourtCard from '~/components/booking/CourtCard.vue'\r\nimport BottomCTA from '~/components/ui/BottomCTA.vue'\r\n\r\nuseHead({ title: 'Pick a court — DINK' })\r\n\r\nconst store = useBookingStore()\r\nif (store.slotIndex === null) {\r\n  navigateTo('/')\r\n}\r\n\r\nfunction selectCourt(id: number) {\r\n  store.setCourt(id)\r\n}\r\n\r\nfunction goNext() {\r\n  if (store.courtId !== null) {\r\n    navigateTo('/book/paddles')\r\n  }\r\n}\r\n</script>\r\n"],"version":3}