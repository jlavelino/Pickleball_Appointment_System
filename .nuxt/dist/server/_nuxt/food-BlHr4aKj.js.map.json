{"file":"food-BlHr4aKj.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;mBACOA,eAAAC,WAAA,EAAA,OAAM,kFAA8E,MAAA,CAAA,0JAMhCC,eAAA,QAAA,KAAK,IAAI,0DAExDA,eAAA,QAAA,KAAK,KAAK,8GAQH,QAAA,YAAQ,CAAA,IAAA,cAAA,uUAOqC,QAAA,QAAQ,qDAGrD,QAAA,YAAQ,EAAA,IAAA,cAAA;;;;;;;;;;;;;;ACS3B,YAAQ,EAAE,OAAO,yBAAyB;AAE1C,UAAM,QAAQ,gBAAA;AACd,QAAI,MAAM,YAAY,MAAM;AAC1B,iBAAW,aAAa;AAAA,IAC1B;AAEA,aAAS,SAAS;AAChB,YAAM,UAAA;AACN,iBAAW,eAAe;AAAA,IAC5B;;mBA7COF,eAAAC,WAAA,EAAA,OAAM,2BAAA,GAA0B,MAAA,CAAA,8NAMdE,MAAA,KAAA,EAAM,cAAc,SAAK,SAAA;AAGtBC,oBAAAD,MAAA,WAAA,IAAL,MAAC;AAEX,cAAA,gHAAAD,eAAA,EAAE,KAAK,CAAA,gBAAA;sBAGE,EAAE,OAAK,CAAZ,MAAC;;YACP,KAAK,EAAE;AAAA,YACP,MAAM;AAAA,YACN,UAAUC,MAAA,KAAA,EAAM,QAAQ,EAAE,EAAE,KAAA;AAAA,YAC5B,QAAI,CAAG,QAAQA,MAAA,KAAA,EAAM,WAAW,EAAE,IAAI,GAAG;AAAA,UAAA;;;;;;QAM7C,OAAOA,MAAA,KAAA,EAAM,YAAS,IAAA,iBAAA;AAAA,QACtB,SAAO;AAAA,MAAA;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_ssrInterpolate","_unref","_ssrRenderList"],"sources":["../../../../components/booking/FoodItemRow.vue","../../../../pages/book/food.vue"],"sourcesContent":["<template>\r\n  <div class=\"flex items-center gap-[14px] py-[14px] border-b border-line last:border-none\">\r\n    <!-- Warm Food Swatch -->\r\n    <div class=\"w-12 h-12 rounded-[12px] bg-[#EFC98B] flex-shrink-0\"></div>\r\n\r\n    <!-- Info -->\r\n    <div class=\"flex-1 min-w-0\">\r\n      <div class=\"font-semibold text-[15.5px] truncate\">{{ food.name }}</div>\r\n      <div class=\"text-gray text-[13.5px] mt-[1px]\">\r\n        ₱{{ food.price }}\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Stepper -->\r\n    <div class=\"flex items-center gap-3 flex-shrink-0\">\r\n      <button\r\n        type=\"button\"\r\n        :disabled=\"quantity <= 0\"\r\n        @click=\"$emit('step', -1)\"\r\n        aria-label=\"Decrease\"\r\n        class=\"w-[30px] h-[30px] rounded-full border border-line bg-white text-base cursor-pointer text-ink flex items-center justify-center disabled:opacity-30 disabled:cursor-not-allowed hover:border-ink transition-colors\"\r\n      >\r\n        −\r\n      </button>\r\n      <div class=\"w-4 text-center font-semibold text-[15px]\">{{ quantity }}</div>\r\n      <button\r\n        type=\"button\"\r\n        :disabled=\"quantity >= 20\"\r\n        @click=\"$emit('step', 1)\"\r\n        aria-label=\"Increase\"\r\n        class=\"w-[30px] h-[30px] rounded-full border border-line bg-white text-base cursor-pointer text-ink flex items-center justify-center disabled:opacity-30 disabled:cursor-not-allowed hover:border-ink transition-colors\"\r\n      >\r\n        +\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nimport type { FoodItem } from '~/stores/booking'\r\n\r\ndefineProps<{\r\n  food: FoodItem\r\n  quantity: number\r\n}>()\r\n\r\ndefineEmits<{\r\n  step: [dir: number]\r\n}>()\r\n</script>\r\n","<template>\r\n  <div class=\"flex flex-col min-h-full\">\r\n    <div class=\"flex-1\">\r\n      <h1 class=\"font-display font-semibold text-[28px] m-0 leading-[1.15] mb-0.5 mt-1.5\">\r\n        Pre-order food\r\n      </h1>\r\n      <p class=\"text-ink-soft text-[14.5px] m-0 mb-5 leading-[1.4]\">\r\n        Ready by your {{ store.selectedSlot?.label || '7:00 PM' }} session\r\n      </p>\r\n\r\n      <template v-for=\"g in FOOD_GROUPS\" :key=\"g.label\">\r\n        <div class=\"text-[12.5px] tracking-[0.04em] uppercase text-gray font-bold mt-[18px] mb-1 first:mt-0\">\r\n          {{ g.label }}\r\n        </div>\r\n        <FoodItemRow\r\n          v-for=\"f in g.items\"\r\n          :key=\"f.id\"\r\n          :food=\"f\"\r\n          :quantity=\"store.foodQty[f.id] || 0\"\r\n          @step=\"(dir) => store.setFoodQty(f.id, dir)\"\r\n        />\r\n      </template>\r\n    </div>\r\n\r\n    <BottomCTA\r\n      :label=\"store.foodCount > 0 ? 'Review order' : 'Add food, or skip'\"\r\n      @click=\"goNext\"\r\n    />\r\n  </div>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nimport { useBookingStore, FOOD_GROUPS } from '~/stores/booking'\r\nimport FoodItemRow from '~/components/booking/FoodItemRow.vue'\r\nimport BottomCTA from '~/components/ui/BottomCTA.vue'\r\n\r\nuseHead({ title: 'Pre-order food — DINK' })\r\n\r\nconst store = useBookingStore()\r\nif (store.courtId === null) {\r\n  navigateTo('/book/court')\r\n}\r\n\r\nfunction goNext() {\r\n  store.startHold()\r\n  navigateTo('/book/summary')\r\n}\r\n</script>\r\n"],"version":3}